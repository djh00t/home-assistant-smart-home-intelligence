{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/presence_event.schema.json",
  "title": "Presence Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "source", "type", "room", "entity_class", "confidence", "ts"],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z_]+::sha256:[0-9a-f]{64}$",
      "description": "Opaque deterministic event identifier used on canonical and dead-letter MQTT outputs."
    },
    "source": {
      "type": "string",
      "enum": ["frigate", "mmwave", "motion", "face", "anpr", "tracker"]
    },
    "type": {
      "type": "string",
      "enum": ["enter", "leave", "stay", "state_change", "confidence"]
    },
    "room": {
      "type": "string",
      "enum": [
        "room_alpha",
        "room_beta",
        "room_gamma",
        "room_delta",
        "room_zeta",
        "zone_alpha",
        "zone_beta",
        "zone_gamma",
        "room_epsilon"
      ]
    },
    "camera": {
      "type": "string",
      "minLength": 1,
      "description": "Camera or sensor identifier when a visual source is involved."
    },
    "entity_class": {
      "type": "string",
      "enum": ["human", "pet", "vehicle"]
    },
    "person_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(unknown|resident::sha256:[0-9a-f]{64})$",
      "description": "Opaque household resident reference or the literal unknown."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tracker_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^tracker::sha256:[0-9a-f]{64}$",
      "description": "Opaque tracker reference when the event originated from a visual or occupancy track."
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plate_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^plate::sha256:[0-9a-f]{64}$"
        },
        "plate_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vehicle_type": {
          "type": "string",
          "enum": ["car", "truck", "motorcycle", "unknown"]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "with_pram": {
          "type": "boolean"
        },
        "with_face_match": {
          "type": "boolean"
        },
        "is_owner_plate": {
          "type": "boolean"
        },
        "lighting_blocked": {
          "type": "boolean"
        }
      }
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp in RFC 3339 format."
    }
  }
}
